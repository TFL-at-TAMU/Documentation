---
// Starlight component override for `Header` (see astro.config.mjs ->
// starlight({ components: { Header: ... } })). Starlight's default header is
// just title + search + theme-select + GitHub icon — it doesn't carry the
// site's four shared nav links (Home / Documentation / Safety / Contact)
// that the landing page (src/pages/index.astro) already renders in its own
// top bar. This wraps the default Header and adds those links alongside it.
import Default from '@astrojs/starlight/components/Header.astro';

const navLinks = [
	{ href: '/', label: 'Home' },
	{ href: '/docs/', label: 'Documentation' },
	{ href: '/safety/', label: 'Safety' },
	// Built in Phase 2; linked ahead of time per the migration plan.
	{ href: '/contact/', label: 'Contact' },
];

const currentPath = Astro.url.pathname;

/** Home is only "active" on an exact match; the rest match by prefix. */
function isActive(href: string): boolean {
	if (href === '/') return currentPath === '/';
	return currentPath === href || currentPath.startsWith(href);
}
---

<div class="site-nav-header">
	<nav class="site-nav" aria-label="Site">
		<ul>
			{
				navLinks.map((link) => (
					<li>
						<a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>
							{link.label}
						</a>
					</li>
				))
			}
		</ul>
	</nav>
	<div class="default-header">
		<Default {...Astro.props}><slot /></Default>
	</div>
</div>

<style>
	.site-nav-header {
		display: flex;
		align-items: center;
		gap: 1.5rem;
		width: 100%;
	}

	.site-nav {
		/* Hidden below 50rem, where Starlight switches to the hamburger drawer —
		   the four links live in the drawer there (see MobileMenuFooter.astro).
		   Shown at >= 50rem, exactly where the hamburger disappears, so there's
		   no width band with no reachable nav. */
		display: none;
	}

	.site-nav ul {
		display: flex;
		align-items: center;
		gap: 1.25rem;
		list-style: none;
		margin: 0;
		padding: 0;
		white-space: nowrap;
	}

	.site-nav a {
		display: inline-block;
		padding: 0.25rem 0;
		font-size: var(--sl-text-sm);
		font-weight: 600;
		color: var(--sl-color-text);
		text-decoration: none;
		border-bottom: 2px solid transparent;
		transition: color 0.15s ease, border-color 0.15s ease;
	}

	.site-nav a:hover {
		color: var(--sl-color-text-accent);
	}

	.site-nav a[aria-current='page'] {
		color: var(--sl-color-text-accent);
		border-bottom-color: var(--sl-color-accent);
	}

	.default-header {
		flex: 1;
		min-width: 0;
	}

	/* Below 50rem the nav lives in the hamburger drawer, so these wrapper divs
	   have no job — and their flex context was making the header taller than
	   Starlight's native content height, pushing search out of alignment with
	   the (independently positioned) hamburger. `display: contents` removes the
	   wrappers from layout so Starlight's default header aligns natively. */
	@media (max-width: 49.9999rem) {
		.site-nav-header,
		.default-header {
			display: contents;
		}
	}

	@media (min-width: 50rem) {
		.site-nav {
			display: block;
		}
	}
</style>
